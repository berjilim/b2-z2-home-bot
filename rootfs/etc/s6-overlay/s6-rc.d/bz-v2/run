#!/usr/bin/env bash
# ==============================================================================
# Start BZ-V2 — translate Supervisor options.json into the env vars
# src/main.mjs expects, then exec the single Node process that runs
# everything (ACP runner, HA listener, wake-glue, Telegram bot).
# ==============================================================================

echo "[$(date -Iseconds)] INFO: Starting BZ-V2..."

OPTIONS="/data/options.json"
if [ ! -f "${OPTIONS}" ]; then
    echo "[$(date -Iseconds)] FATAL: No options.json found"
    exit 1
fi

export CLAUDE_CODE_OAUTH_TOKEN="$(jq -r '.claude_oauth_token' ${OPTIONS})"
export TELEGRAM_BOT_TOKEN="$(jq -r '.telegram_bot_token' ${OPTIONS})"

# Support both new (owner_chat_id) and legacy (telegram_bernard_id) field names.
OWNER_ID="$(jq -r '.owner_chat_id // empty' ${OPTIONS})"
if [ -z "${OWNER_ID}" ]; then
    OWNER_ID="$(jq -r '.telegram_bernard_id // empty' ${OPTIONS})"
fi
export OWNER_CHAT_ID="${OWNER_ID}"

# Diagnostic: confirm which bot identity this token resolves to, and the
# exact length/shape of the configured values, WITHOUT logging the secrets
# themselves — helps catch config-save corruption without exposing tokens.
BOT_IDENTITY="$(curl -s "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/getMe" | jq -r '.result.username // .description // "unknown"')"
echo "[$(date -Iseconds)] DEBUG: telegram_bot_token resolves to bot @${BOT_IDENTITY}"
echo "[$(date -Iseconds)] DEBUG: telegram_bot_token length=${#TELEGRAM_BOT_TOKEN} owner_chat_id=[${OWNER_CHAT_ID}] (length=${#OWNER_CHAT_ID})"
echo "[$(date -Iseconds)] DEBUG: claude_oauth_token length=${#CLAUDE_CODE_OAUTH_TOKEN} prefix=${CLAUDE_CODE_OAUTH_TOKEN:0:14}"

# Source SUPERVISOR_TOKEN from s6-overlay environment if not already set
if [ -z "${SUPERVISOR_TOKEN}" ] && [ -f /run/s6/container_environment/SUPERVISOR_TOKEN ]; then
    SUPERVISOR_TOKEN="$(cat /run/s6/container_environment/SUPERVISOR_TOKEN)"
fi

export HA_URL="http://supervisor/core"
export HA_TOKEN="${SUPERVISOR_TOKEN}"

mkdir -p /data/memory
cp -n /app/memory/*.md /data/memory/ 2>/dev/null
export MEMORY_DIR="/data/memory"

mkdir -p /data/standing-orders
cp -n /app/standing-orders/active.json /data/standing-orders/ 2>/dev/null
cp /app/standing-orders/SCHEMA.md /data/standing-orders/SCHEMA.md
export ORDERS_PATH="/data/standing-orders/active.json"

export AGENT_CWD="/data"

exec node /app/src/main.mjs
